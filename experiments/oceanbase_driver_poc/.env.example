# OceanBase Driver POC 环境变量样例
#
# 复制为 .env 并填入真实值，或在 CI / 执行环境中直接注入环境变量。
# 本文件只允许出现占位符：真实账号、口令与地址不得提交到仓库。
#
# 必填项缺一不可；缺失时 run_poc.py 会把该模式的全部检查记为 SKIP_NO_ENV
# （未执行），而不是报错退出，也不会记为通过。

# ---- MySQL 兼容模式 ----
# 端口无默认值：OBProxy 与直连使用不同端口，写死默认值会让 POC 指向错误端点。
OB_MYSQL_HOST=__FILL_ME__
OB_MYSQL_PORT=__FILL_ME__
# OceanBase 经 OBProxy 连接时用户名形如 user@tenant#cluster，原样填写，不要改写。
OB_MYSQL_USER=__FILL_ME__
OB_MYSQL_PASSWORD=__FILL_ME__
OB_MYSQL_DATABASE=__FILL_ME__
OB_MYSQL_SCHEMA=__FILL_ME__

# ---- Oracle 兼容模式 ----
OB_ORACLE_HOST=__FILL_ME__
OB_ORACLE_PORT=__FILL_ME__
OB_ORACLE_USER=__FILL_ME__
OB_ORACLE_PASSWORD=__FILL_ME__
# DSN 使用 service name，不是 SID。
OB_ORACLE_SERVICE_NAME=__FILL_ME__
OB_ORACLE_SCHEMA=__FILL_ME__

# ---- 可选：超时与连接池（留空则用下方默认值）----
# 连接超时（秒），默认 5
# OB_MYSQL_CONNECT_TIMEOUT_S=5
# OB_ORACLE_CONNECT_TIMEOUT_S=5
# 查询超时（秒），默认 30；会同时下发到客户端与 ob_query_timeout 会话变量
# OB_MYSQL_QUERY_TIMEOUT_S=30
# OB_ORACLE_QUERY_TIMEOUT_S=30
# 连接池下限/上限，默认 0/5
# OB_MYSQL_POOL_MIN=0
# OB_MYSQL_POOL_MAX=5
# OB_ORACLE_POOL_MIN=0
# OB_ORACLE_POOL_MAX=5

# ---- 可选：连接超时检查的目标（默认 192.0.2.1:2883）----
# 必须是「不可达」的地址：该检查断言连接在配置期限内失败。
# 指向真实主机的关闭端口只能测到「拒绝连接」，那是立即返回的，证明不了超时参数。
# OB_MYSQL_UNREACHABLE_HOST=192.0.2.1
# OB_MYSQL_UNREACHABLE_PORT=2883
# OB_ORACLE_UNREACHABLE_HOST=192.0.2.1
# OB_ORACLE_UNREACHABLE_PORT=2883

# ---- 可选但强烈建议：观测账号 ----
# Query Timeout 检查要求证明「服务端查询确实停止」，而不是只有客户端放弃等待。
# 这需要第二个账号在超时后用 information_schema.processlist / v$session 观测服务端，
# 它只需要只读与 PROCESS（MySQL）或等同的观测权限，不需要写权限，也不要给运行账号
# 加管理权限。
#
# 不配置这两个变量时：Query Timeout 仍会执行并按结果记录 client 侧观测，但服务端
# 结论为「无法判定」，该项因此记 INDETERMINATE —— 不会记为通过。
# OB_MYSQL_OBSERVER_USER=__FILL_ME__
# OB_MYSQL_OBSERVER_PASSWORD=__FILL_ME__
# OB_ORACLE_OBSERVER_USER=__FILL_ME__
# OB_ORACLE_OBSERVER_PASSWORD=__FILL_ME__

# ---- 可选：元数据检查的目标对象 ----
# 不填时自动选取该 schema 下的第一张表（按名称排序），确定性且无需额外配置。
# OB_MYSQL_METADATA_TABLE=__FILL_ME__
# OB_ORACLE_METADATA_TABLE=__FILL_ME__

# ---- 仅开发用：MariaDB 自检后端 ----
# 见 scripts/mariadb_smoke.sh。用于在没有 OceanBase 时验证 POC 自身的检查代码，
# 它验证的是「harness 写对了没有」，不是「OceanBase 兼容不兼容」。
# 结果必须以 --runtime mariadb-smoke 运行，且不得写入结论文档。
